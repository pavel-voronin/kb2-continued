 extern uint32_t emulator_speed;
+static Bit32s startupSavedCycles = 0;
+static int startupRequestedCycles = 0;
+static bool webFilesEnabled = false;
+static bool webImportReady = false;
+static bool webChooseImported = false;
+
+bool jsdos::prepareSaveSearch(char* pattern) {
+  if (!webFilesEnabled || std::string(server_get_running_program()) != "KB2" ||
+      std::string(pattern).find("*.KB2") == std::string::npos) return true;
+  if (!webImportReady) {
+    client_log("kb2-files", "load-request");
+    return false;
+  }
+  std::strcpy(pattern, "WEBGAME.KB2");
+  webImportReady = false;
+  webChooseImported = true;
+  return true;
+}
+
+bool jsdos::takeImportedSaveKey() {
+  if (!webChooseImported || std::string(server_get_running_program()) != "KB2") return false;
+  webChooseImported = false;
+  return true;
+}
+
+void jsdos::saveFileClosed(const char* name, uint32_t flags) {
+  if (!webFilesEnabled || !name || (flags & 3) == 0 ||
+      std::string(server_get_running_program()) != "KB2") return;
+  const std::string path(name);
+  if ((path.size() >= 4 && path.substr(path.size()-4) == ".KB2") || path == "KB2.DAT") {
+    const std::string message = "saved:" + path;
+    client_log("kb2-files", message.c_str());
+  }
+}
+
+void jsdos::gameTerminated() {
+  if (webFilesEnabled && std::string(server_get_running_program()) == "KB2")
+    client_log("kb2-files", "game-exit");
+}
+
+void jsdos::beginStartup() {
+  if (startupRequestedCycles > 0 && startupSavedCycles == 0 &&
+      std::string(server_get_running_program()) == "KB2") {
+    startupSavedCycles = CPU_CycleMax;
+    CPU_CycleMax = startupRequestedCycles;
+    RDTSC_rebase();
+    client_log("kb2-startup", "graphics-init");
+  }
+}
+
+void jsdos::finishStartup() {
+  if (startupSavedCycles <= 0 || std::string(server_get_running_program()) != "KB2") return;
+  if (startupSavedCycles > 0) CPU_CycleMax = startupSavedCycles;
+  startupRequestedCycles = 0;
+  startupSavedCycles = 0;
+  RDTSC_rebase();
+  const std::string message = "ready;cycles=" + std::to_string(CPU_CycleMax);
+  client_log("kb2-startup", message.c_str());
+}
